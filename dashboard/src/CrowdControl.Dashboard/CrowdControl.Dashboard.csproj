<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <!-- Core <- Adapters <- Dashboard: the UI only talks to the ports, never to SignalR directly -->
  <ItemGroup>
    <ProjectReference Include="..\CrowdControl.Dashboard.Core\CrowdControl.Dashboard.Core.csproj" />
    <ProjectReference Include="..\CrowdControl.Dashboard.Adapters\CrowdControl.Dashboard.Adapters.csproj" />
  </ItemGroup>

</Project>
