<mxfile host="app.diagrams.net">
  <diagram id="crowdcontrol-c2" name="C2 – Containers">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titel -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 18px&quot;&gt;CrowdControl – Container-diagram (C2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#666666&quot;&gt;Opdateret med konkrete teknologier, oktober 2026&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="50" width="480" height="60" as="geometry" />
        </mxCell>

        <!-- Personer -->
        <mxCell id="participant" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Event-Participant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Participates in event and shares location" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="0" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="holder" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Event Holder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Worker at e.g. a festival who monitors the event" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="0" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- System boundary -->
        <mxCell id="boundary" value="&lt;b style=&quot;font-size: 14px&quot;&gt;CrowdControl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Software System – lokalt kørt via Docker Compose]&lt;/font&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;connectable=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="1200" height="900" as="geometry" />
        </mxCell>

        <!-- Containere -->
        <mxCell id="mobile" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: JavaScript, HTML – no framework, no build step]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Consent page. Reads position via the browser Geolocation API at a fixed interval and sends it with an anonymous sessionId." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="dashboard" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: C#, Blazor WebAssembly (.NET 10), Bootstrap]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Live heatmap of the event and admin panel for creating events and zones." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="280" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ingestion" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Ingestion-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: Java 21, Spring Boot 4.1 – Spring MVC, Spring AMQP, JdbcClient]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives positions, validates them against active events and event areas, rate-limits and publishes them to the queue. Serves the mobile app. Hexagonal: Maven modules per adapter." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="280" height="190" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Message broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: RabbitMQ 4]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Queue &lt;i&gt;positions&lt;/i&gt; (Java → C#) and exchange &lt;i&gt;event-changes&lt;/i&gt; (C# → Java). Contracts: AsyncAPI + JSON Schema." style="shape=cylinder3;size=15;direction=south;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="600" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="processing" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Processing-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: C#, ASP.NET Core (.NET 10), SignalR]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Customers, login, events, aggregation to grid cells, history and zones. Serves the dashboard. Clean architecture: Domain, Application, Infrastructure, Api." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="280" height="190" as="geometry" />
        </mxCell>

        <mxCell id="eventdb" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Event-database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: PostgreSQL 17, PostGIS 3.5]&lt;br&gt;Schema: Flyway migrations&lt;/font&gt;&lt;br&gt;&lt;br&gt;Copy of active events: ID, timeframe and area (geometry). Owned by ingestion-server." style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="maindb" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Main Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: PostgreSQL 17]&lt;br&gt;Schema: EF Core migrations&lt;/font&gt;&lt;br&gt;&lt;br&gt;Tables: customers, event hosts, users, events, heatmap, zones. Owned by processing-server." style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="880" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Relationer -->
        <mxCell id="e1" value="Uses app and gives consent to share location&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="participant" target="mobile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Monitors event and creates events/zones&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="holder" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Sends positions&lt;br&gt;[REST, JSON/HTTPS – OpenAPI]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="mobile" target="ingestion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Fetches static content&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="mobile" target="ingestion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Fetches static content&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="dashboard" target="processing">
          <mxGeometry x="-0.55" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Pushes live updates&lt;br&gt;[SignalR, WebSocket]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="processing" target="dashboard">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Fetches history&lt;br&gt;[REST, JSON/HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="dashboard" target="processing">
          <mxGeometry x="0.55" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="Fetches active events on startup&lt;br&gt;[REST, JSON/HTTPS – Spring RestClient]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.05;entryX=0;entryY=0.05;" edge="1" parent="1" source="ingestion" target="processing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="Publishes positions&lt;br&gt;[AMQP]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.45;entryX=0.45;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ingestion" target="broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="Delivers event changes&lt;br&gt;[AMQP]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.75;" edge="1" parent="1" source="broker" target="ingestion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Delivers positions&lt;br&gt;[AMQP]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.45;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.45;" edge="1" parent="1" source="broker" target="processing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Publishes EventCreated /&lt;br&gt;EventUpdated / EventDeleted&lt;br&gt;[AMQP]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="processing" target="broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e13" value="Reads/writes active events and event areas&lt;br&gt;[JDBC (JdbcClient), SQL]&lt;br&gt;Migrates schema on startup [Flyway]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ingestion" target="eventdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="Reads/writes customers, events and heatmap data&lt;br&gt;[EF Core 10, Npgsql, SQL]&lt;br&gt;Migrates schema on startup [EF Core migrations]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="processing" target="maindb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
