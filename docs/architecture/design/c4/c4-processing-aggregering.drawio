        <mxCell id="n21" parent="1" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" value="&lt;b&gt;GridAggregator.Add&lt;/b&gt;&lt;br&gt;celle x = floor((lon - minLon) / cellSizeLon)&lt;br&gt;celle y = floor((lat - minLat) / cellSizeLat)&lt;br&gt;minLat/minLon er hjørnet af eventets område. Zonetal øges, når PolygonHelper.IsInside er sand." vertex="1"><mxGeometry x="1000" y="300" width="380" height="110" as="geometry" /></mxCell>
