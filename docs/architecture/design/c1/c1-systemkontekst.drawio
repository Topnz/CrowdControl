        <mxCell id="deltager" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=mxgraph.c4.person2;spacingTop=36;fillColor=#6b6477;strokeColor=#4d4757;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Deltager&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Deltager i eventet. Giver samtykke og deler sin position pseudonymt fra mobilen.&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="0" width="240" height="200" as="geometry" /></mxCell>
        <mxCell id="arrangoer" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=mxgraph.c4.person2;spacingTop=36;fillColor=#6b6477;strokeColor=#4d4757;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Arrangør&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Medarbejder hos arrangøren. Overvåger eventet og opretter events og zoner.&lt;/span&gt;" vertex="1"><mxGeometry x="720" y="0" width="240" height="200" as="geometry" /></mxCell>
        <mxCell id="cc" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#3c6bb3;strokeColor=#2c5494;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;CrowdControl&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Modtager positioner fra deltagere, samler dem i grid-celler og viser et live heatmap med antal deltagere pr. zone. Én installation pr. arrangør.&lt;/span&gt;" vertex="1"><mxGeometry x="300" y="320" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="cf" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Cloudflare quick tunnel&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Software System, ekstern]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Offentligt HTTPS-link til mobil-appen i LAN-tilstand (kun udvikling).&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="340" width="200" height="110" as="geometry" /></mxCell>
