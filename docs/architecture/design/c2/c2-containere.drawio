<mxfile host="Electron">
  <diagram id="c2" name="C2 – Containere">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;spacing=12;align=right;" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;CrowdControl&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/span&gt;" vertex="1"><mxGeometry x="0" y="240" width="1360" height="980" as="geometry" /></mxCell>
        <mxCell id="deltager" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=mxgraph.c4.person2;spacingTop=36;fillColor=#6b6477;strokeColor=#4d4757;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Deltager&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;" vertex="1"><mxGeometry x="100" y="0" width="200" height="180" as="geometry" /></mxCell>
        <mxCell id="arrangoer" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=mxgraph.c4.person2;spacingTop=36;fillColor=#6b6477;strokeColor=#4d4757;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Arrangør&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;" vertex="1"><mxGeometry x="1040" y="0" width="200" height="180" as="geometry" /></mxCell>
        <mxCell id="app" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: JavaScript, HTML, CSS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Samtykkeside med information om data og opbevaringstid, stop-knap og status. Læser position via Geolocation API og sender den pseudonymt.&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="280" width="320" height="150" as="geometry" /></mxCell>
        <mxCell id="dash" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: C#, Blazor WebAssembly, Leaflet]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Live heatmap with the number of participants per zone. A standalone static site (own dev server, port 5111). Later: login, history and an admin panel for events and zones.&lt;/span&gt;" vertex="1"><mxGeometry x="980" y="280" width="320" height="150" as="geometry" /></mxCell>
        <mxCell id="ing" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Ingestion-server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: Java 21, Spring Boot 4.1]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Modtager positioner, rate-limiter pr. session, afviser positioner uden for aktive events og finder zoner. Serverer mobil-appen.&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="640" width="320" height="160" as="geometry" /></mxCell>
        <mxCell id="mq" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=mxgraph.flowchart.direct_data;spacingRight=20;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Message broker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: RabbitMQ 4]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Kø &amp;#x27;positions&amp;#x27; (Java → C#) og exchange &amp;#x27;event-changes&amp;#x27; (C# → Java).&lt;/span&gt;" vertex="1"><mxGeometry x="540" y="640" width="260" height="160" as="geometry" /></mxCell>
        <mxCell id="proc" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Processing-server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: C#, ASP.NET Core, SignalR]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Aggregates positions into grid cells and zone counts and pushes snapshots. REST + SignalR only (does not serve the dashboard). Later: login, events, zones and history.&lt;/span&gt;" vertex="1"><mxGeometry x="980" y="640" width="320" height="160" as="geometry" /></mxCell>
        <mxCell id="eventdb" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=cylinder3;size=14;boundedLbl=1;backgroundOutline=1;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;fillColor=#eef1f6;strokeColor=#8c9ab3;fontColor=#5a6478;dashed=1;dashPattern=6 4;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Event-database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 17 + PostGIS 3.5]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Kopi af aktive events: ID, tidsrum, område, zoner og sendeinterval.&lt;/span&gt;" vertex="1"><mxGeometry x="80" y="1020" width="240" height="160" as="geometry" /></mxCell>
        <mxCell id="maindb" parent="1" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;shape=cylinder3;size=14;boundedLbl=1;backgroundOutline=1;fillColor=#5b9bd5;strokeColor=#3f7fb9;fontColor=#ffffff;" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Main Database&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL 17]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;users, events, zones og heatmap (kun aggregerede data, gemmes 24 måneder).&lt;/span&gt;" vertex="1"><mxGeometry x="1020" y="1020" width="240" height="160" as="geometry" /></mxCell>
