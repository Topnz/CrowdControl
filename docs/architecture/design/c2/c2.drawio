<mxfile host="Electron">
  <diagram id="crowdcontrol-c2" name="C2 – Containers">
    <mxGraphModel dx="861" dy="784" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" value="&lt;b style=&quot;font-size: 18px&quot;&gt;CrowdControl – Container-diagram (C2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#666666&quot;&gt;Opdateret med konkrete teknologier, oktober 2026&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="380" y="50" as="geometry" />
        </mxCell>
        <object label="&lt;b style=&quot;font-size: 15px&quot;&gt;Event Participant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Participates in event and shares location" id="participant">
          <mxCell parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="180" width="220" x="80" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="holder" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Event Holder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Worker at e.g. a festival who monitors the event" vertex="1">
          <mxGeometry height="180" width="220" x="940" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;connectable=0;recursiveResize=0;pointerEvents=0;absoluteArcSize=1;" value="&lt;b style=&quot;font-size: 14px&quot;&gt;CrowdControl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Software System – lokalt kørt via Docker Compose]&lt;/font&gt;" vertex="1">
          <mxGeometry height="900" width="1200" x="20" y="230" as="geometry" />
        </mxCell>
        <mxCell id="mobile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: JavaScript, HTML – no framework, no build step]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Consent page with data/retention info, stop button and sharing status. Reads position via the Geolocation API at the interval set by the event holder, sends it with an anonymous sessionId and stops when the event ends." vertex="1">
          <mxGeometry height="150" width="280" x="60" y="280" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: C#, Blazor WebAssembly (.NET 10), Bootstrap]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Login, live heatmap with zone counts and capacity alerts, history, and admin panel for events and zones." vertex="1">
          <mxGeometry height="150" width="280" x="900" y="280" as="geometry" />
        </mxCell>
        <mxCell id="ingestion" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Ingestion-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: Java 21, Spring Boot 4.1 – Spring MVC, Spring AMQP, JdbcClient]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives positions, validates them against active events and event areas, rate-limits and publishes them to the queue. Serves the mobile app and its event settings (interval, end time). Hexagonal: Maven modules per adapter." vertex="1">
          <mxGeometry height="190" width="280" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="broker" parent="1" style="shape=cylinder3;size=15;direction=south;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Message broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: RabbitMQ 4]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Queue &lt;i&gt;positions&lt;/i&gt; (Java → C#) and exchange &lt;i&gt;event-changes&lt;/i&gt; (C# → Java). Contracts: AsyncAPI + JSON Schema." vertex="1">
          <mxGeometry height="150" width="280" x="480" y="600" as="geometry" />
        </mxCell>
        <mxCell id="processing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Processing-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: C#, ASP.NET Core (.NET 10), SignalR]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Login, events, zones, aggregation to grid cells, capacity alerts, history and deletion of data older than 24 months. Serves the dashboard. Clean architecture: Domain, Application, Infrastructure, Api." vertex="1">
          <mxGeometry height="190" width="280" x="900" y="560" as="geometry" />
        </mxCell>
        <mxCell id="eventdb" parent="1" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Event-database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: PostgreSQL 17, PostGIS 3.5]&lt;br&gt;Schema: Flyway migrations&lt;/font&gt;&lt;br&gt;&lt;br&gt;Copy of active events: ID, timeframe, area (geometry) and send interval. Owned by ingestion-server." vertex="1">
          <mxGeometry height="160" width="280" x="60" y="880" as="geometry" />
        </mxCell>
        <mxCell id="maindb" parent="1" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" value="&lt;b style=&quot;font-size: 15px&quot;&gt;Main Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: PostgreSQL 17]&lt;br&gt;Schema: EF Core migrations&lt;/font&gt;&lt;br&gt;&lt;br&gt;Tables: users, events, zones, heatmap (aggregated only, kept 24 months). Owned by processing-server." vertex="1">
          <mxGeometry height="160" width="280" x="900" y="880" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="participant" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" target="mobile" value="Uses app and gives consent to share location&lt;br&gt;[HTTPS]">
